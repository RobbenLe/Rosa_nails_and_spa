GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Password for the /admin page of the website
ADMIN_PASSWORD=
# Online only: Postgres connection (set by the Neon integration). Unset = local SQLite file.
DATABASE_URL=
# Online only: the website address allowed to call this API
FRONTEND_ORIGINS=http://localhost:5173

# --- Chatbot ---
# Kill switch: the chatbot only runs when this is exactly "true". Change it and redeploy to turn it off.
CHATBOT_ENABLED=false
# Key for the AI service (Anthropic). Set a monthly spend limit of 20 euro in the Anthropic console.
ANTHROPIC_API_KEY=
# Connection string of the READ-ONLY database user (chatbot_reader, SELECT on services only).
# Locally you can use: sqlite:///database.db
CHATBOT_DATABASE_URL=
# Optional: override the default AI model
CHATBOT_MODEL=
